# Demo-only local defaults for the CDMS prototype. Do not use these values in production.
# Docker Compose overrides hostnames with service DNS names: postgres and redis.
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cdms
DATABASE_USER=cdms
DATABASE_PASSWORD=cdms_demo_password

REDIS_HOST=localhost
REDIS_PORT=6379

POLL_INTERVAL_MS=5000
INVENTORY_SEED_COUNT=1000

IMPORT_BATCH_SIZE=500
IMPORT_MAX_PENDING_BATCHES=100
IMPORT_MAX_FILE_SIZE_MB=100
IMPORT_REDIS_RETRY_TIMEOUT_MS=30000

CHANGE_WORKER_CONCURRENCY=10

OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=1000
